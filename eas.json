{
  "cli": {
    "version": ">= 16.17.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview-mobile": {
      "distribution": "internal",
      "env": { "EXPO_TV": "0" },
      "android": { "buildType": "apk" }
    },
    "preview-tv": {
      "distribution": "internal",
      "env": { "EXPO_TV": "1" },
      "android": { "buildType": "apk" }
    },
    "production-mobile": {
      "env": { "EXPO_TV": "0" },
      "android": { "buildType": "app-bundle" }
    },
    "production-tv": {
      "env": { "EXPO_TV": "1" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
